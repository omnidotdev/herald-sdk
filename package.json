{
	"name": "@omnidotdev/herald",
	"version": "0.1.0",
	"description": "Official TypeScript SDK for Herald, the Omni transactional and marketing email API.",
	"type": "module",
	"main": "./build/index.js",
	"module": "./build/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./build/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"build",
		"src/index.ts",
		"src/generated",
		"src/graphql-env.d.ts"
	],
	"license": "Apache-2.0",
	"author": "Omni <hey@omni.dev>",
	"homepage": "https://herald.omni.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/omnidotdev/herald-sdk.git"
	},
	"bugs": "https://github.com/omnidotdev/herald-sdk/issues",
	"keywords": [
		"omni",
		"herald",
		"email",
		"transactional-email",
		"sdk"
	],
	"publishConfig": {
		"registry": "https://api.manifold.omni.dev/npm/"
	},
	"scripts": {
		"build": "bun src/scripts/build.ts",
		"check": "biome check",
		"format": "biome format --write",
		"generate": "bash scripts/generate.sh",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"graphql": "^16.14.0",
		"graphql-request": "^7.4.0",
		"gql.tada": "^1.8.10"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.12",
		"@types/bun": "^1.3.6",
		"typescript": "^5.9.3"
	}
}
