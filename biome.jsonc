{
	"$schema": "https://biomejs.dev/schemas/2.3.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// generated by odk + gql.tada; not hand-authored, so exclude from lint/format
		"includes": ["**", "!src/generated", "!src/graphql-env.d.ts", "!build"]
	}
}
